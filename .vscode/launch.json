{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Lanzar proyecto",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/src/runs",
            "program": "${workspaceFolder}/src/runs/main.py",
            "args": ["--epochs", "40", "--seed", "42"]
        },
        {
            "name": "Explorar datos",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/src/runs",
            "program": "${workspaceFolder}/src/runs/explore_data.py"
        } 
    ]
}